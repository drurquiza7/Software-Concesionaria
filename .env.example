# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- Django ---
# En el VPS usar config.settings.prod (cookies Secure, HSTS, DEBUG apagado).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generar: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo prod. Ej: https://panel.midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ---
POSTGRES_DB=concesionaria
POSTGRES_USER=concesionaria
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Cifrado de campos (Fernet) ---
# Lista separada por comas. La primera cifra; las demás solo descifran (rotación).
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# --- Red ---
# Cantidad de proxies de confianza delante de Django (Caddy = 1). Con 0 se usa REMOTE_ADDR.
TRUSTED_PROXY_COUNT=1
# Dominio que atiende Caddy. Con "localhost" usa un certificado local.
SITE_ADDRESS=localhost
GUNICORN_WORKERS=3

# --- Negocio ---
# Días de validez de una invitación a un tenant.
INVITACION_VIGENCIA_DIAS=7
